# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=3100
APP_URL=http://localhost:3100
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 32 — cifra los tokens de Meta. No cambiar una vez usada.
ENCRYPTION_KEY=

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=creative
POSTGRES_PASSWORD=creative
POSTGRES_DB=creative_loop
POSTGRES_PORT=5440
# Para comandos desde tu Mac (prisma studio, etc.). Dentro de Docker se sobrescribe.
DATABASE_URL=postgresql://creative:creative@localhost:5440/creative_loop
# Solo si DATABASE_URL apunta a un pooler en modo transacción (Supabase): conexión
# de sesión para las migraciones. En local se deja vacío.
DIRECT_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6385
REDIS_URL=redis://localhost:6385

# ─── Almacenamiento S3 (MinIO en local, R2 en producción) ────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
# Lo que usa el navegador para subir y reproducir (no resuelve "minio").
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_ORIGINALS=creative-originals
S3_BUCKET_DERIVED=creative-derived
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=4096

# ─── Meta (solo lectura) ─────────────────────────────────────────────────────
META_API_VERSION=v24.0

# ─── Usuarios iniciales (seed) ───────────────────────────────────────────────
SEED_PASSWORD=creative123
# false = solo crea los usuarios, sin conceptos ni piezas de ejemplo (producción).
SEED_DEMO=true

# Zona horaria de la interfaz y de los jobs programados
NEXT_PUBLIC_APP_TZ=Europe/Madrid
SCHEDULE_TZ=Europe/Madrid

# Solo desarrollo: menú "Entrar como…" para probar roles sin contraseña. Nunca en producción.
ENABLE_DEV_LOGIN=false

# ─── IA (DeepSeek) ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
